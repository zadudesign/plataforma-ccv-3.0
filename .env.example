# Configuración de Conexión a Supabase (Plataforma CCV 3.0)
# Reemplaza los siguientes valores con las credenciales de tu proyecto en Supabase (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta
